[Unit]
Description=ER Data Publisher
After=network.target

[Service]
User=enabled
WorkingDirectory=/home/enabled/repos/er_data_publisher
Environment="PATH=/home/enabled/.pyenv/versions/3.8.18/bin:/home/enabled/.pyenv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/home/enabled/.pyenv/versions/er_data_publisher/lib/python3.8/site-packages"
ExecStart=/bin/bash /home/enabled/repos/er_data_publisher/run_publisher.sh
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
